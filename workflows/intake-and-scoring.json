      "name": "High Score?"
    },
    {
      "parameters": {
        "jsCode": "const r = $json.output;\nconst id = $('Build Payload').item.json.submission_id;\nconst n = (v, max) => Math.max(0, Math.min(max, Math.round(Number(v) || 0)));\n\nconst thesis_fit = n(r.thesis_fit, 3);\nconst traction_score = n(r.traction, 3);\nconst clarity = n(r.clarity, 2);\nconst ask_realism = n(r.ask_realism, 1);\nconst investor_fit = n(r.investor_fit, 1);\n\nconst flags = r.red_flags || [];\nlet score = thesis_fit + traction_score + clarity + ask_realism + investor_fit;\nif (thesis_fit <= 1 || flags.some(f => f.severity === 'high')) score = Math.min(score, 4);\nif (r.injection_detected) score = 0;\n\nreturn { json: {\n  submission_id: id, thesis_fit, traction_score, clarity, ask_realism, investor_fit,\n  fit_score: score,\n  recommended_action: score >= 8 ? 'meet' : score >= 5 ? 'more_info' : 'pass',\n  fit_reason: r.fit_reason,\n  red_flags: flags.map(f => `${f.severity}: ${f.flag}`).join('; ') || 'none',\n  draft_reply: r.draft_reply,\n  status: 'scored',\n  processed_at: new Date().toISOString()\n}};"
      },

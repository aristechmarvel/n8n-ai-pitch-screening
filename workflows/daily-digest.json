      "id": "3d32a40b-ed43-42f9-853c-38af0f31d33f",
      "name": "Get scored pitches",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const DAY = 24 * 60 * 60 * 1000;\nconst now = Date.now();\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r.submission_id); // drops the empty item on quiet days\n\nconst picks = rows\n  .filter(r => {\n    const t = new Date(r.processed_at).getTime();\n    return !isNaN(t) && now - t <= DAY && Number(r.fit_score) >= 7;\n  })\n  .sort((a, b) => Number(b.fit_score) - Number(a.fit_score))\n  .slice(0, 10)\n  .map(r => ({\n    company: r.company,\n    website: r.website,\n    one_liner: r.one_liner,\n    stage: r.stage,\n    sector: r.sector,\n    amount: r.amount,\n    deck_link: r.deck_link || 'not provided',\n    founder_name: r.founder_name,\n    founder_email: r.founder_email,\n    fit_score: Number(r.fit_score),\n    recommended_action: r.recommended_action,\n    fit_reason: r.fit_reason,\n    red_flags: r.red_flags,\n    draft_reply: r.draft_reply\n  }));\n\nreturn [{ json: { count: picks.length, pitches: picks } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -128
      ],
      "id": "52de76d8-e9cf-4243-b1e8-7f5837be0c2c",
      "name": "Filter & Rank"
    },
